# What this repo serves: the measured "kda4" build of GLM-5.3-Flash on 2x DGX Spark.
# Site values (IPs, NICs, HF cache path, worker SSH target) are NOT here: they come from the upstream repo's .env
# (UPSTREAM_DIR), which you fill in once per that repo's README. Any line below can be overridden for one run:
#     PORT=8100 ./serve.sh

UPSTREAM_DIR="${UPSTREAM_DIR:-$HOME/GLM53F-NvidiaNVFP4-DFlash}"   # your clone of 0rand/glm-5.3-flash-nvidia-nvfp4-dflash-2x-dgx-sparks

# --- serving (the tested values; the numbers in the README were measured with exactly these) ----------------------
PORT="${PORT:-8000}"
SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-glm-5.3-flash}"
K="${K:-7}"                                   # DFlash2 draft depth (upstream ships 5)
CTX="${CTX:-900096}"                          # longest request (3,516 x 256)
KV_CACHE_MEMORY="${KV_CACHE_MEMORY:-9663676416}"   # 9 GiB KV pin per rank = 1,043,808 KV tokens
GMU="${GMU:-0.88}"
SEQS="${SEQS:-4}"
BATCH="${BATCH:-1024}"
CAPTURE_SIZE="${CAPTURE_SIZE:-16}"
MIN_FREE_GIB="${MIN_FREE_GIB:-108}"           # serve.sh waits for this much MemAvailable on BOTH nodes before booting

# --- pins: everything that decides the result ----------------------------------------------------------------------
IMAGE="${IMAGE:-pilcothink/vllm_spark_glm53:0.28}"
IMAGE_PIN="pilcothink/vllm_spark_glm53@sha256:e99cb670acdedd3234c595cd81dbefa7f091507268c78f659b3286a957a5536f"
IMAGE_ID="sha256:9f218ab5578fc7a2e97b3b44fe50798af8167a49a38cfeaafa3d0755781a3e09"
MODEL_REPO="nvidia/GLM-5.3-Flash-NVFP4"
MODEL_REVISION="09b04e5e74bca08ca8549fc736d4cdd8624bfde3"
DRAFT_REPO="incoai/GLM-5.3-Flash-DFlash2"
DRAFT_REVISION="bf582e4eacc1810f76656d1811693ff6c6737d2a"
UPSTREAM_COMMIT="4ec03bfc1e6a22b0ca59f73da3bd57c5d9a145ff"      # the upstream commit this was validated on
LAUNCHER_SHA256="ad3a7bfc8a47989fa4c74e4f8c6d77acf44a60c36b523ef84dbd6d211267be83"   # upstream vendor/run_cluster_dual.sh
# The rebuilt 4-bit KDA weights are deterministic: a fresh build must reproduce these bytes exactly.
KDA_FILE_SHA256="9d2f2a63050e84e17e560b6e66902a7e59f8bba11a53df6b497a701dfa40bc0c"   # model-kda-nvfp4.safetensors (2.61 GB)
KDA_INDEX_SHA256="f008c41edc476c1e966aae95a387e78d47242390e62d7a9128115bf141df7cc2"  # model.safetensors.index.json
